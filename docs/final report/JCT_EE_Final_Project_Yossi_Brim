להלן מימוש המודל בינה מלאכותית, שכבת הגישה לחומרה (HAL) ומכונת המצבים (FSM) של מערכת ה-Edge כפי שפותחו והורצו על גבי ה-Raspberry Pi בהוכחת ההיתכנות האמפירית מול מצלמת קצה ומסך I2C:

\subsection*{1. מודול ניהול לוגיקת המערכת ומכונת המצבים (\texttt{main\_system.py})}
\begin{english}
\begin{lstlisting}[language=Python, caption={Main Edge Hardware Fall Detection Loop}]
import cv2
import time
from picamera2 import Picamera2
from pose_engine import PoseEngine
from i2c_display import I2CDisplay

class FallDetectionSystem:
    def __init__(self):
        self.engine = PoseEngine()
        self.display = I2CDisplay()
        
        # Direct data pipeline initialization to camera hardware
        print("Initializing Hardware Camera (Picamera2)...")
        self.picam2 = Picamera2()
        config = self.picam2.create_video_configuration(main={"size": (640, 480)})
        self.picam2.configure(config)
        
        print("System Initialized. Running in LIVE Edge Hardware mode.")

    def run(self):
        self.picam2.start()
        print("Warming up sensor...")
        time.sleep(2)  # Sensor exposure stabilization time
        
        self.display.show_message("Status: Normal")
        
        fall_frames_count = 0
        fall_detected_state = False

        print("Starting live FSM inference loop. Press Ctrl+C to stop.")
        
        try:
            while True:
                # 1. Hardware frame capture and OpenCV format conversion
                frame = self.picam2.capture_array()
                frame_bgr = cv2.cvtColor(frame, cv2.COLOR_RGB2BGR)

                # 2. Feature extraction and geometry via AI Engine
                geometry = self.engine.process_frame(frame_bgr)
                current_frame_fall = False

                if geometry:
                    print(f"Debug -> W: {geometry['w']}, H: {geometry['h']}")

                    if geometry['w'] > (geometry['h'] * 0.8):
                        fall_frames_count += 1
                    else:
                        fall_frames_count = 0

                    # 3. Debounce mechanism: 2 consecutive frames to validate
                    if fall_frames_count >= 2:
                        current_frame_fall = True
                else:
                    fall_frames_count = 0

                # 4. FSM State Transitions & OLED Output
                if current_frame_fall and not fall_detected_state:
                    fall_detected_state = True
                    self.display.show_message("ALERT: FALL!")
                    print("FSM State Transition: [NORMAL] -> [FALL DETECTED]")
                
                elif not current_frame_fall and fall_detected_state:
                    fall_detected_state = False
                    self.display.show_message("Status: Normal")
                    print("FSM State Transition: [FALL DETECTED] -> [NORMAL]")

        except KeyboardInterrupt:
            print("\nGraceful shutdown requested...")
        finally:
            self.picam2.stop()
            self.display.clear()
            print("System Offline. Hardware released.")

if __name__ == "__main__":
    system = FallDetectionSystem()
    system.run()
\end{lstlisting}
\end{english}

