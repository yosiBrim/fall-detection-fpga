    \centering
    \includegraphics[width=0.8\textwidth]{image_281e14.png}
    \caption{סכמה חשמלית של סולם הנגדים היוצרים יחד מחלק מתח}
    \label{fig:dac_voltage_divider}
\end{figure}

\subsection{ניהול תחומי שעון (Clock Domains) וסנכרון זרימת הנתונים}
בבסיס הארכיטקטורה מיושם מודול מבוסס PLL המפיק שעונים יציבים: שעון ייעודי למצלמה (\texttt{xclk\_pll} בתדר $24\text{MHz}$), ושעון תצוגה (\texttt{vga\_pll} בתדר $25\text{MHz}$).

\subsubsection{זיכרון התמונה וממשק הסינכרון}
רכיב ה-Dual-Port BRAM מספק הפרדה חומרתית מוחלטת: תחום הקליטה מכניס נתונים בתדר $100\text{MHz}$, בעוד תחום התצוגה (VGA Domain) שולף אותם בתדר $25\text{MHz}$.

לשם סנכרון תצוגה מדויק, הכתובת מחושבת על פי הנוסחה $Address = X + 640 \times Y$. במקביל, הנתון הנשלף ננעל בתוך \texttt{pxl\_data\_reg} כדי להתגבר על זמן ה-Read Latency.

