    \centering
    \includegraphics[width=0.85\textwidth]{pathR_G_B.png}
    \caption{תרשים זרימה של עיבוד הפיקסל: מזיכרון ה-\textenglish{BRAM}, דרך מנגנון הרישום והסנכרון, ועד לניתוב לערוצי ה-\textenglish{RGB}}
    \label{fig:pixel_processing_rgb}
\end{figure}

מאחר שמסך ה-\textenglish{VGA} דורש אותות אנלוגיים רציפים, הוטמעה המרה דיגיטלית-לאנלוגית (\textenglish{DAC}) פסיבית באמצעות רשת נגדים (\textenglish{Resistor Network}). הביט המשמעותי ביותר (\textenglish{MSB}) מחובר לנגד בעל הערך הנמוך ביותר ($510\Omega$) להזרמת זרם מרבי, והביט הפחות משמעותי (\textenglish{LSB}) מחובר לנגד הגדול ביותר ($4\text{k}\Omega$). הזרמים מתנקזים לאדמה דרך נגד סיומת של $75\Omega$ המובנה במסך. שילוב זה יוצר מחלק מתח דינמי הממיר בצורה חלקה את רמות המתח הספרתיות למתח אנלוגי תקני. במקביל, אותות הסנכרון (\textenglish{HSYNC} ו-\textenglish{VSYNC}) מוגנים מזרם יתר באמצעות נגדי טור של $100\Omega$.

